# Copy this file to .env and fill in your values before running docker compose up

# At least one of the LLM providers below must be configured. The active
# provider per role is chosen from the UI (Settings → Models) and persisted
# to backend/data/llm_config.json. Defaults use OpenAI.

# OpenAI (default provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (optional — required if you route any role to Anthropic)
ANTHROPIC_API_KEY=

# Google Gemini (optional — required if you route any role to Gemini).
# Either variable works; GOOGLE_API_KEY is preferred.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Local vLLM (optional — used by the docker compose `local-llm` profile).
# The model service exposes an OpenAI-compatible API at /v1.
LOCAL_VLLM_IMAGE=vllm-node
LOCAL_VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LOCAL_VLLM_SERVED_MODEL_NAME=local-qwen3.6
LOCAL_VLLM_BASE_URL=http://localhost:9001/v1
# Used only by the Docker Compose backend service. host.docker.internal works
# for a vLLM server published on the host at LOCAL_VLLM_PORT.
BACKEND_LOCAL_VLLM_BASE_URL=http://host.docker.internal:9001/v1
# Alternative when you want direct Compose service DNS:
# BACKEND_LOCAL_VLLM_BASE_URL=http://llm:9001/v1
LOCAL_VLLM_API_KEY=EMPTY
LOCAL_VLLM_DISABLE_THINKING=true
LOCAL_VLLM_PORT=9001
LOCAL_VLLM_MAX_MODEL_LEN=32768
LOCAL_VLLM_MAX_NUM_BATCHED_TOKENS=16384
LOCAL_VLLM_GPU_MEMORY_UTILIZATION=0.7
LOCAL_VLLM_TENSOR_PARALLEL=1
HF_TOKEN=

# Optional GLM-OCR / vLLM vision endpoint (OpenAI-compatible).
# Leave empty for PyMuPDF-only parsing (recommended default).
# OCR_SERVER_URL=http://ocr:8080/v1/chat/completions   # when using: docker compose --profile ocr up
# OCR_SERVER_URL=https://your-remote-host/v1/chat/completions

# Optional — OpenAlex polite pool (recommended for discovery)
OPENALEX_EMAIL=
# CONTACT_EMAIL=              # fallback for OPENALEX_EMAIL

# OCR service (docker compose `ocr` service — optional GPU)
# Default max_model_len is 8192 (enough per PDF page). Raise only if you have headroom.
OCR_MAX_MODEL_LEN=8192
OCR_GPU_MEMORY_UTILIZATION=0.85

# Optional — used by the research tools extension (Tavily search)
TAVILY_API_KEY=

# Optional — override the Tavily API base URL
# DLAI_TAVILY_BASE_URL=
