# Copy this file to .env and fill in your values before running docker compose up

# At least one of the LLM providers below must be configured. The active
# provider per role is chosen from the UI (Settings → Models) and persisted
# to backend/data/llm_config.json. Defaults use OpenAI.

# OpenAI (default provider)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude (optional — required if you route any role to Anthropic)
ANTHROPIC_API_KEY=

# Google Gemini (optional — required if you route any role to Gemini).
# Either variable works; GOOGLE_API_KEY is preferred.
GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional — used by the research tools extension (Tavily search)
TAVILY_API_KEY=

# Optional — override the Tavily API base URL
# DLAI_TAVILY_BASE_URL=
